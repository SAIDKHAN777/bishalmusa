{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "ignoreRegExpList": [
    "/[\\u0900-\\u097F]+/g"
  ],
  "ignorePaths": [
    "node_modules/**",
    "frontend/node_modules/**",
    "dist/**",
    "frontend/dist/**",
    "frontend/public/**",
    ".astro/**",
    "uploads/**",
    "coverage/**",
    "package-lock.json",
    "frontend/package-lock.json",
    "prisma/migrations/**"
  ],
  "words": [
    "aarav",
    "apos",
    "argon",
    "astro",
    "astrojs",
    "behance",
    "bishal",
    "bullmq",
    "claint",
    "cleverx",
    "cloudinary",
    "cuid",
    "depcheck",
    "dribbble",
    "glassmorphism",
    "hidpi",
    "ioredis",
    "jafri",
    "lucide",
    "mehta",
    "musa",
    "noopener",
    "noreferrer",
    "nosniff",
    "pdfjs",
    "pino",
    "prisma",
    "roas",
    "saidkhan",
    "sardar",
    "secretlint",
    "shayari",
    "speckit",
    "tailwindcss",
    "tseslint",
    "turnstile",
    "unlighthouse",
    "uploaders",
    "upstash",
    "vite",
    "vitest",
    "webgl",
    "webp",
    "workstore"
  ]
}
