---
import { env } from '../lib/env';
import { generatePersonSchema, generateWebSiteSchema, generateArticleSchema } from '../lib/seo';

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = 'Said Khan | Senior Software Engineer & Backend Architect',
  description = 'Personal portfolio, distributed backend architectures, engineering articles, and technical projects of Said Khan.',
  canonicalUrl = Astro.url.href,
  ogImage = `${env.SITE_URL}/og-image.png`,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  jsonLd,
} = Astro.props;

const siteTitle = title.includes('Said Khan') ? title : `${title} | Said Khan`;

// Build default JSON-LD schemas
const defaultSchemas: Array<Record<string, any>> = [
  generatePersonSchema(),
  generateWebSiteSchema(),
];

if (ogType === 'article' && publishedTime) {
  defaultSchemas.push(
    generateArticleSchema({
      title,
      description,
      url: canonicalUrl,
      publishedAt: publishedTime,
      updatedAt: modifiedTime,
      keywords: tags,
      imageUrl: ogImage,
    })
  );
}

const schemasToRender = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : defaultSchemas;
---

<!-- Primary Meta Tags -->
<title>{siteTitle}</title>
<meta name="title" content={siteTitle} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content="Said Khan Portfolio" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter Cards -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={siteTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />
<meta property="twitter:creator" content="@saidkhan" />

<!-- Structured Data (JSON-LD) -->
{schemasToRender.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
