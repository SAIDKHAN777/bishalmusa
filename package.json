{
  "name": "portfolio-backend",
  "type": "module",
  "version": "1.0.0",
  "description": "Enterprise Personal Portfolio Backend & CMS",
  "scripts": {
    "dev": "astro dev",
    "start": "node ./dist/server/entry.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src/ frontend/src/",
    "format": "prettier --write .",
    "review": "node scripts/code-review.mjs",
    "review:lint": "eslint src/ frontend/src/",
    "review:secrets": "secretlint \"src/**/*\" \"frontend/src/**/*\" \"prisma/schema.prisma\"",
    "review:spell": "cspell \"src/**/*.ts\" \"frontend/src/**/*.{ts,tsx}\" --no-progress",
    "review:deps": "depcheck frontend --ignore-dirs=dist --ignores=\"@tailwindcss/vite,@types/*,tailwindcss,typescript,vite\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:push": "prisma db push",
    "worker": "tsx src/jobs/run-worker.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@astrojs/node": "^9.0.0",
    "@astrojs/react": "^4.2.0",
    "@astrojs/tailwind": "^5.1.0",
    "@prisma/client": "^6.4.0",
    "@sentry/node": "^8.54.0",
    "argon2": "^0.45.2",
    "astro": "^5.3.0",
    "bullmq": "^6.7.6",
    "cloudinary": "^2.11.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.11.1",
    "marked": "^18.2.0",
    "pino": "^9.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.38.1",
    "sanitize-html": "^2.18.2",
    "tailwindcss": "^3.4.17",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.50.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^3.2.7",
    "cspell": "^10.5.2",
    "depcheck": "^1.4.7",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.4.0",
    "secretlint": "^14.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.0.5"
  }
}
