# Server Configuration
NODE_ENV=development
PORT=4321
HOST=0.0.0.0
SITE_URL=http://localhost:4321

# Database (PostgreSQL - Pooled, Direct & Test)
# Production: append ?sslmode=require
DATABASE_URL=postgresql://app_user:strong_password@localhost:5432/portfolio_backend_db
DIRECT_URL=postgresql://migrator_user:strong_password@localhost:5432/portfolio_backend_db
TEST_DATABASE_URL=postgresql://app_user:strong_password@localhost:5432/portfolio_test_db

# Redis & BullMQ
REDIS_URL=redis://localhost:6379

# Authentication & Admin
SESSION_SECRET=super_secret_session_key_minimum_32_characters_long_12345
ADMIN_EMAIL=admin@saidkhan.dev
ADMIN_PASSWORD=SuperSecretAdminPassword123!

# Error Tracking (Sentry)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Media (Cloudinary)
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=sample_cloudinary_api_secret

# Email Dispatch (Resend)
RESEND_API_KEY=re_123456789abcdef
CONTACT_RECEIVER_EMAIL=contact@saidkhan.dev

# Telegram Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Spam Protection (Cloudflare Turnstile)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Privacy Analytics
ANALYTICS_SALT=internal_privacy_salt_hash_random_key_minimum_32_chars
